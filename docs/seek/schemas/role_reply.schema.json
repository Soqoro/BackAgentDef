{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "role": {
      "enum": [
        "Goal",
        "State",
        "Action"
      ]
    },
    "stage": {
      "type": "string"
    },
    "spans": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start": {
            "type": "integer"
          },
          "end": {
            "type": "integer"
          },
          "text": {
            "type": "string"
          },
          "replacement": {
            "type": "string"
          },
          "source_fact": {
            "type": "string"
          }
        },
        "required": [
          "start",
          "end",
          "text",
          "replacement",
          "source_fact"
        ],
        "additionalProperties": false
      }
    },
    "predicate": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "operation": {
              "enum": [
                "search",
                "click"
              ]
            },
            "argument": {
              "type": "string"
            },
            "match": {
              "enum": [
                "exact",
                "contains"
              ]
            },
            "target": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "label": {
              "enum": [
                "contract_violation",
                "preference_dependence"
              ]
            },
            "scope": {
              "enum": [
                "next_proposal"
              ]
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "operation",
            "argument",
            "match",
            "target",
            "label",
            "scope",
            "evidence"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "objections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "span_index": {
            "type": "integer"
          },
          "source_fact": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "change": {
            "enum": [
              "reject",
              "keep",
              "request_test"
            ]
          }
        },
        "required": [
          "span_index",
          "source_fact",
          "reason",
          "change"
        ],
        "additionalProperties": false
      }
    },
    "approved_masks": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "integer"
        }
      }
    },
    "probe_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prediction": {
      "type": "string"
    },
    "alternative": {
      "type": "string"
    },
    "revision": {
      "type": "string"
    },
    "interpretation": {
      "type": "string"
    }
  },
  "required": [
    "role",
    "stage",
    "spans",
    "predicate",
    "objections",
    "approved_masks",
    "probe_ids",
    "prediction",
    "alternative",
    "revision",
    "interpretation"
  ],
  "additionalProperties": false
}
